-- ==============================================================================
-- RAILWAY ENTERPRISE POSTGRESQL SCHEMA BLUEPRINT
-- Platform: Railway (PostgreSQL 16+ with PostGIS)
-- Architecture: Domain-Driven Separation of Concerns (PostgreSQL Schemas)
-- ==============================================================================

-- ------------------------------------------------------------------------------
-- EXTENSIONS & GLOBAL SETTINGS
-- ------------------------------------------------------------------------------
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE EXTENSION IF NOT EXISTS "postgis";

SET timezone = 'UTC';

-- ------------------------------------------------------------------------------
-- SEPARATE DOMAIN SCHEMAS (Namespaces)
-- ------------------------------------------------------------------------------
CREATE SCHEMA IF NOT EXISTS identity_auth;
CREATE SCHEMA IF NOT EXISTS user_profiles;
CREATE SCHEMA IF NOT EXISTS core_media;
CREATE SCHEMA IF NOT EXISTS travel_experiences;
CREATE SCHEMA IF NOT EXISTS social_feed;
CREATE SCHEMA IF NOT EXISTS notifications;

-- Standardized updated_at trigger function
CREATE OR REPLACE FUNCTION trigger_set_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ==============================================================================
-- 1. DOMAIN: IDENTITY & AUTHENTICATION (Schema: identity_auth)
-- ==============================================================================

CREATE TYPE identity_auth.user_role AS ENUM (
  'user',
  'local_legend',
  'pro_guardian',
  'moderator',
  'admin'
);

-- Core credentials & security account (Isolated from public profile)
CREATE TABLE identity_auth.accounts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) NOT NULL,
    password_hash VARCHAR(255) NOT NULL, -- Argon2id hash
    role identity_auth.user_role NOT NULL DEFAULT 'user',
    is_email_verified BOOLEAN NOT NULL DEFAULT FALSE,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    is_banned BOOLEAN NOT NULL DEFAULT FALSE,
    ban_reason TEXT,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX uq_accounts_email ON identity_auth.accounts (LOWER(email));
CREATE INDEX idx_accounts_role_active ON identity_auth.accounts (role, is_active);

-- User Refresh Tokens (for stateless JWT rotation)
CREATE TABLE identity_auth.refresh_tokens (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    account_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    token_hash VARCHAR(255) NOT NULL,
    user_agent TEXT,
    client_ip INET,
    is_revoked BOOLEAN NOT NULL DEFAULT FALSE,
    expires_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_refresh_tokens_account ON identity_auth.refresh_tokens (account_id, is_revoked);
CREATE INDEX idx_refresh_tokens_expires ON identity_auth.refresh_tokens (expires_at);

CREATE TRIGGER set_timestamp_accounts
BEFORE UPDATE ON identity_auth.accounts
FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();

-- ==============================================================================
-- 2. DOMAIN: OBJECT STORAGE & MEDIA METADATA (Schema: core_media)
-- NOTE: Raw binaries NEVER hit Railway. Only verified CDN links & BlurHash.
-- ==============================================================================

CREATE TYPE core_media.asset_status AS ENUM (
  'pending_upload', -- Upload ticket issued to client
  'uploaded',       -- Binary arrived in S3 / R2
  'verified',       -- Validated dimensions, blurhash generated, CDN active
  'rejected'        -- Size/mime violation
);

CREATE TYPE core_media.media_category AS ENUM (
  'avatar',
  'post_photo',
  'post_video',
  'trip_cover',
  'trail_stop_photo',
  'guardian_verification_id'
);

CREATE TABLE core_media.assets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    uploader_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    category core_media.media_category NOT NULL,
    status core_media.asset_status NOT NULL DEFAULT 'pending_upload',
    
    -- Object Storage References (AWS S3 / Cloudflare R2)
    storage_bucket VARCHAR(100) NOT NULL,
    storage_key VARCHAR(500) NOT NULL UNIQUE, -- e.g., 'uploads/users/uuid/photo.webp'
    cdn_url TEXT,                             -- e.g., 'https://cdn.yourapp.com/uploads/users/uuid/photo.webp'
    
    -- File Properties
    mime_type VARCHAR(100) NOT NULL,          -- e.g., 'image/webp', 'image/jpeg'
    file_size_bytes BIGINT NOT NULL CHECK (file_size_bytes > 0),
    width INT CHECK (width > 0),
    height INT CHECK (height > 0),
    aspect_ratio NUMERIC(5, 3),
    
    -- Fast placeholder string (instant UI paint with zero layout shift)
    blurhash VARCHAR(100),
    
    -- Expiry for cleanup cron if upload never finished
    upload_expires_at TIMESTAMPTZ NOT NULL,
    verified_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_media_uploader_status ON core_media.assets (uploader_id, status);
CREATE INDEX idx_media_pending_cleanup ON core_media.assets (status, upload_expires_at) 
    WHERE status = 'pending_upload';

-- ==============================================================================
-- 3. DOMAIN: USER PROFILES & SOCIAL GRAPH (Schema: user_profiles)
-- ==============================================================================

CREATE TABLE user_profiles.profiles (
    account_id UUID PRIMARY KEY REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    username VARCHAR(40) NOT NULL,
    display_name VARCHAR(100) NOT NULL,
    bio VARCHAR(250),
    avatar_media_id UUID REFERENCES core_media.assets(id) ON DELETE SET NULL,
    
    -- Location & Privacy
    city VARCHAR(100),
    country VARCHAR(100),
    age INT CHECK (age >= 13),
    show_age BOOLEAN NOT NULL DEFAULT FALSE,
    
    -- Vibe Guardian & Local Legend Specific Profile Data
    is_guardian_active BOOLEAN NOT NULL DEFAULT FALSE,
    guardian_headline VARCHAR(150),
    guardian_experience_years INT DEFAULT 0,
    guardian_hourly_rate_cents INT CHECK (guardian_hourly_rate_cents >= 0),
    guardian_flat_rate_cents INT CHECK (guardian_flat_rate_cents >= 0),
    currency VARCHAR(3) DEFAULT 'USD',
    
    -- Denormalized Engagement Counters (Maintained via triggers for sub-millisecond reads)
    followers_count INT NOT NULL DEFAULT 0 CHECK (followers_count >= 0),
    following_count INT NOT NULL DEFAULT 0 CHECK (following_count >= 0),
    posts_count INT NOT NULL DEFAULT 0 CHECK (posts_count >= 0),
    handshakes_count INT NOT NULL DEFAULT 0 CHECK (handshakes_count >= 0),
    
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX uq_profiles_username_ci ON user_profiles.profiles (LOWER(username));
CREATE INDEX idx_profiles_location ON user_profiles.profiles (country, city);
CREATE INDEX idx_profiles_guardian_active ON user_profiles.profiles (is_guardian_active) 
    WHERE is_guardian_active = TRUE;

-- Social Follow Relationship
CREATE TABLE user_profiles.follows (
    follower_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    following_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (follower_id, following_id),
    CONSTRAINT chk_no_self_follow CHECK (follower_id <> following_id)
);

CREATE INDEX idx_follows_following_created ON user_profiles.follows (following_id, created_at DESC);

-- Verified Handshake Proof System (Proof of real in-person interaction)
CREATE TABLE user_profiles.handshakes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    host_account_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    guest_account_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    interaction_type VARCHAR(50) NOT NULL DEFAULT 'vibe_guide', -- 'hire_pro', 'vibe_local'
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT chk_no_self_handshake CHECK (host_account_id <> guest_account_id),
    CONSTRAINT uq_host_guest_interaction UNIQUE (host_account_id, guest_account_id, interaction_type)
);

CREATE INDEX idx_handshakes_host ON user_profiles.handshakes (host_account_id, created_at DESC);
CREATE INDEX idx_handshakes_guest ON user_profiles.handshakes (guest_account_id, created_at DESC);

CREATE TRIGGER set_timestamp_profiles
BEFORE UPDATE ON user_profiles.profiles
FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();

-- ==============================================================================
-- 4. DOMAIN: TRAVEL EXPERIENCES & CHECK-INS (Schema: travel_experiences)
-- ==============================================================================

-- Verified Geolocation POIs (PostGIS Powered)
CREATE TABLE travel_experiences.check_ins (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    account_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    place_name VARCHAR(200) NOT NULL,
    category VARCHAR(80) NOT NULL,
    address TEXT,
    city VARCHAR(100) NOT NULL,
    country VARCHAR(100) NOT NULL,
    
    -- Spatial coordinates using standard EPSG 4326 (WGS 84 GPS Lat/Long)
    latitude NUMERIC(10, 7) NOT NULL,
    longitude NUMERIC(10, 7) NOT NULL,
    location_geom GEOMETRY(Point, 4326) GENERATED ALWAYS AS (
        ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)
    ) STORED,
    accuracy_meters NUMERIC(6, 2),
    
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_checkins_location_gist ON travel_experiences.check_ins USING GIST (location_geom);
CREATE INDEX idx_checkins_user_created ON travel_experiences.check_ins (account_id, created_at DESC);
CREATE INDEX idx_checkins_city ON travel_experiences.check_ins (country, city);

-- Trips & Vibe Trails / Tours
CREATE TABLE travel_experiences.trails (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    creator_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    title VARCHAR(200) NOT NULL,
    slug VARCHAR(250) NOT NULL,
    description TEXT,
    cover_media_id UUID REFERENCES core_media.assets(id) ON DELETE SET NULL,
    
    -- Distinction: Regular Vibe Trail vs Pro Guardian Vibe Tour
    is_tour BOOLEAN NOT NULL DEFAULT FALSE,
    tour_price_cents INT CHECK (tour_price_cents >= 0),
    tour_duration_label VARCHAR(50), -- e.g., '6h', 'Full Day'
    meeting_point TEXT,
    languages VARCHAR(100)[],         -- Array of spoken languages
    whats_included TEXT[],           -- Items included
    cancellation_policy TEXT,
    
    -- Geo aggregation
    city VARCHAR(100) NOT NULL,
    country VARCHAR(100) NOT NULL,
    total_stops INT NOT NULL DEFAULT 0 CHECK (total_stops >= 0),
    is_public BOOLEAN NOT NULL DEFAULT TRUE,
    
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX uq_trails_creator_slug ON travel_experiences.trails (creator_id, slug);
CREATE INDEX idx_trails_city_tour ON travel_experiences.trails (country, city, is_tour, created_at DESC);
CREATE INDEX idx_trails_creator ON travel_experiences.trails (creator_id, created_at DESC);

-- Itinerary Stops inside a Vibe Trail / Tour
CREATE TABLE travel_experiences.trail_stops (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    trail_id UUID NOT NULL REFERENCES travel_experiences.trails(id) ON DELETE CASCADE,
    stop_number INT NOT NULL CHECK (stop_number > 0),
    title VARCHAR(200) NOT NULL,
    description TEXT,
    cover_media_id UUID REFERENCES core_media.assets(id) ON DELETE SET NULL,
    check_in_id UUID REFERENCES travel_experiences.check_ins(id) ON DELETE SET NULL,
    latitude NUMERIC(10, 7),
    longitude NUMERIC(10, 7),
    estimated_minutes INT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (trail_id, stop_number)
);

CREATE INDEX idx_trail_stops_order ON travel_experiences.trail_stops (trail_id, stop_number ASC);

CREATE TRIGGER set_timestamp_trails
BEFORE UPDATE ON travel_experiences.trails
FOR EACH ROW EXECUTE FUNCTION trigger_set_timestamp();

-- ==============================================================================
-- 5. DOMAIN: SOCIAL FEED & ENGAGEMENT (Schema: social_feed)
-- ==============================================================================

-- Travel Posts (The Core Feed)
CREATE TABLE social_feed.posts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    author_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    trail_id UUID REFERENCES travel_experiences.trails(id) ON DELETE SET NULL,
    check_in_id UUID REFERENCES travel_experiences.check_ins(id) ON DELETE SET NULL,
    
    caption TEXT,
    vibe_category VARCHAR(60) NOT NULL DEFAULT 'Vibe Spot',
    vibe_score INT CHECK (vibe_score BETWEEN 1 AND 5),
    
    -- Optional post-specific location pin
    location_name VARCHAR(200),
    latitude NUMERIC(10, 7),
    longitude NUMERIC(10, 7),
    location_geom GEOMETRY(Point, 4326),
    
    -- Denormalized Counters
    likes_count INT NOT NULL DEFAULT 0 CHECK (likes_count >= 0),
    comments_count INT NOT NULL DEFAULT 0 CHECK (comments_count >= 0),
    media_count INT NOT NULL DEFAULT 0 CHECK (media_count >= 0),
    
    is_published BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- Crucial High-Throughput Keyset Pagination Index (Cursor Pagination)
CREATE INDEX idx_posts_feed_cursor ON social_feed.posts (created_at DESC, id DESC) 
    WHERE is_published = TRUE;
CREATE INDEX idx_posts_author_cursor ON social_feed.posts (author_id, created_at DESC);
CREATE INDEX idx_posts_trail ON social_feed.posts (trail_id) WHERE trail_id IS NOT NULL;
CREATE INDEX idx_posts_spatial_gist ON social_feed.posts USING GIST (location_geom) 
    WHERE location_geom IS NOT NULL;

-- Post Media Junction (Associates multiple media assets to a single post with ordering)
CREATE TABLE social_feed.post_media (
    post_id UUID NOT NULL REFERENCES social_feed.posts(id) ON DELETE CASCADE,
    media_asset_id UUID NOT NULL REFERENCES core_media.assets(id) ON DELETE CASCADE,
    sort_order INT NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (post_id, media_asset_id)
);

CREATE INDEX idx_post_media_order ON social_feed.post_media (post_id, sort_order ASC);

-- Reactions / Likes
CREATE TABLE social_feed.post_likes (
    post_id UUID NOT NULL REFERENCES social_feed.posts(id) ON DELETE CASCADE,
    account_id UUID NOT NULL REFERENCES identity_auth.accounts(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (post_id, account_id)
);

CREATE INDEX idx_post_likes_user ON social_feed.post_likes (account_id, created_at DESC);

-- Threaded Post Comments
CREATE TABLE social_feed.comments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
