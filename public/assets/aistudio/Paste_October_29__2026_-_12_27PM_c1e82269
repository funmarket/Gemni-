```markdown
# Production PostgreSQL DDL Migrations (Optimized for Railway)

This migration script establishes the schema for:
1. identity domain: Users, Profiles, User Follows.
2. travel domain: Trips, Travel Posts, Check-ins, Post Likes, Post Comments.
3. media domain: Media Assets with S3/CDN URLs, BlurHash, dimensional anchors, and link associations.

It enables PostGIS for geospatial indexing and uses UUIDv7 / cryptographic UUIDs for distributed indexing performance.

```sql
-- ==============================================================================
-- DATABASE INITIALIZATION & EXTENSIONS
-- ==============================================================================
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE EXTENSION IF NOT EXISTS "postgis";

-- Enforce standard UTC timestamps across sessions
SET timezone = 'UTC';

-- ==============================================================================
-- DOMAIN: IDENTITY
-- ==============================================================================

-- 1. Users Table (Core Auth Entity)
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    is_verified BOOLEAN NOT NULL DEFAULT FALSE,
    role VARCHAR(32) NOT NULL DEFAULT 'user' CHECK (role IN ('user', 'pro_guardian', 'moderator', 'admin')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX uq_users_email_ci ON users (LOWER(email));
CREATE INDEX idx_users_role_active ON users (role, is_active);

-- 2. User Profiles Table (Public Identity Entity)
CREATE TABLE user_profiles (
    user_id UUID PRIMARY KEY,
    username VARCHAR(40) NOT NULL,
    display_name VARCHAR(100) NOT NULL,
    bio TEXT,
    avatar_url TEXT,
    location_city VARCHAR(100),
    location_country VARCHAR(100),
    followers_count INT NOT NULL DEFAULT 0 CHECK (followers_count >= 0),
    following_count INT NOT NULL DEFAULT 0 CHECK (following_count >= 0),
    trips_count INT NOT NULL DEFAULT 0 CHECK (trips_count >= 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_user_profiles_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX uq_user_profiles_username_ci ON user_profiles (LOWER(username));
CREATE INDEX idx_user_profiles_location ON user_profiles (location_country, location_city);

-- 3. User Follows Table (Social Graph)
CREATE TABLE user_follows (
    follower_id UUID NOT NULL,
    following_id UUID NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (follower_id, following_id),
    CONSTRAINT chk_cannot_follow_self CHECK (follower_id <> following_id),
    CONSTRAINT fk_follows_follower FOREIGN KEY (follower_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT fk_follows_following FOREIGN KEY (following_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX idx_user_follows_following ON user_follows (following_id, created_at DESC);

-- ==============================================================================
-- DOMAIN: TRAVEL CONTENT & EXPERIENCES
-- ==============================================================================

-- 4. Trips Table (Curated Travel Itineraries / Folders)
CREATE TABLE trips (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    author_id UUID NOT NULL,
    title VARCHAR(200) NOT NULL,
    slug VARCHAR(250) NOT NULL,
    description TEXT,
    cover_image_url TEXT,
    destination_city VARCHAR(100) NOT NULL,
    destination_country VARCHAR(100) NOT NULL,
    start_date DATE,
    end_date DATE,
    is_public BOOLEAN NOT NULL DEFAULT TRUE,
    is_pro_tour BOOLEAN NOT NULL DEFAULT FALSE,
    tour_price_cents INT CHECK (tour_price_cents >= 0),
    currency VARCHAR(3) DEFAULT 'USD',
    posts_count INT NOT NULL DEFAULT 0 CHECK (posts_count >= 0),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_trips_author FOREIGN KEY (author_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX uq_trips_author_slug ON trips (author_id, slug);
CREATE INDEX idx_trips_author_created ON trips (author_id, created_at DESC);
CREATE INDEX idx_trips_destination ON trips (destination_country, destination_city);
CREATE INDEX idx_trips_pro_tours ON trips (is_pro_tour, created_at DESC) WHERE is_pro_tour = TRUE;

-- 5. Check-Ins Table (Verified Geolocation Sightings / POIs)
CREATE TABLE check_ins (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL,
    place_name VARCHAR(200) NOT NULL,
    place_category VARCHAR(60) NOT NULL,
    address TEXT,
    latitude NUMERIC(10, 7) NOT NULL,
    longitude NUMERIC(10, 7) NOT NULL,
    location_geom GEOMETRY(Point, 4326) GENERATED ALWAYS AS (ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)) STORED,
    accuracy_meters NUMERIC(6, 2),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_checkins_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX idx_checkins_user_created ON check_ins (user_id, created_at DESC);
CREATE INDEX idx_checkins_location_gist ON check_ins USING GIST (location_geom);

-- 6. Travel Posts Table (The Primary Content Feed Entity)
CREATE TABLE travel_posts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    author_id UUID NOT NULL,
    trip_id UUID,
    check_in_id UUID,
    caption TEXT,
    vibe_category VARCHAR(60) NOT NULL DEFAULT 'Vibe Spot',
    vibe_score INT CHECK (vibe_score BETWEEN 1 AND 5),
    latitude NUMERIC(10, 7),
    longitude NUMERIC(10, 7),
    location_geom GEOMETRY(Point, 4326),
    location_name VARCHAR(200),
    likes_count INT NOT NULL DEFAULT 0 CHECK (likes_count >= 0),
    comments_count INT NOT NULL DEFAULT 0 CHECK (comments_count >= 0),
    media_count INT NOT NULL DEFAULT 0 CHECK (media_count >= 0),
    is_published BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_posts_author FOREIGN KEY (author_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT fk_posts_trip FOREIGN KEY (trip_id) REFERENCES trips(id) ON DELETE SET NULL,
    CONSTRAINT fk_posts_checkin FOREIGN KEY (check_in_id) REFERENCES check_ins(id) ON DELETE SET NULL
);

-- High-performance Feed Indexing
CREATE INDEX idx_travel_posts_feed_cursor ON travel_posts (created_at DESC, id DESC) WHERE is_published = TRUE;
CREATE INDEX idx_travel_posts_author_cursor ON travel_posts (author_id, created_at DESC);
CREATE INDEX idx_travel_posts_trip ON travel_posts (trip_id, created_at ASC) WHERE trip_id IS NOT NULL;
CREATE INDEX idx_travel_posts_spatial_gist ON travel_posts USING GIST (location_geom) WHERE location_geom IS NOT NULL;

-- 7. Post Likes Table (Engagement Ledger)
CREATE TABLE post_likes (
    post_id UUID NOT NULL,
    user_id UUID NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (post_id, user_id),
    CONSTRAINT fk_likes_post FOREIGN KEY (post_id) REFERENCES travel_posts(id) ON DELETE CASCADE,
    CONSTRAINT fk_likes_user FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX idx_post_likes_user ON post_likes (user_id, created_at DESC);

-- 8. Post Comments Table
CREATE TABLE post_comments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    post_id UUID NOT NULL,
    author_id UUID NOT NULL,
    parent_comment_id UUID,
    content TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_comments_post FOREIGN KEY (post_id) REFERENCES travel_posts(id) ON DELETE CASCADE,
    CONSTRAINT fk_comments_author FOREIGN KEY (author_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT fk_comments_parent FOREIGN KEY (parent_comment_id) REFERENCES post_comments(id) ON DELETE CASCADE
);

CREATE INDEX idx_post_comments_post_thread ON post_comments (post_id, created_at ASC);

-- ==============================================================================
-- DOMAIN: MEDIA ASSETS & PERFORMANCE OPTIMIZATION
-- ==============================================================================

-- 9. Media Assets Table (Object Storage Anchors)
CREATE TABLE media_assets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    uploader_id UUID NOT NULL,
    post_id UUID,
    storage_bucket VARCHAR(100) NOT NULL,
    storage_key VARCHAR(500) NOT NULL,
    cdn_url TEXT NOT NULL,
    mime_type VARCHAR(100) NOT NULL,
    file_size_bytes BIGINT NOT NULL CHECK (file_size_bytes > 0),
    width INT NOT NULL CHECK (width > 0),
    height INT NOT NULL CHECK (height > 0),
    blurhash VARCHAR(100) NOT NULL,
    sort_order INT NOT NULL DEFAULT 0,
    status VARCHAR(32) NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'uploaded', 'verified', 'failed')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    verified_at TIMESTAMPTZ,
    CONSTRAINT fk_media_uploader FOREIGN KEY (uploader_id) REFERENCES users(id) ON DELETE CASCADE,
    CONSTRAINT fk_media_post FOREIGN KEY (post_id) REFERENCES travel_posts(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX uq_media_storage_key ON media_assets (storage_key);
CREATE INDEX idx_media_post_sort ON media_assets (post_id, sort_order ASC) WHERE post_id IS NOT NULL;
CREATE INDEX idx_media_uploader_status ON media_assets (uploader_id, status);

-- ==============================================================================
-- DATABASE TRIGGERS FOR DENORMALIZED COUNTERS & AUDIT TIMESTAMPS
-- ==============================================================================

CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_users_updated_at BEFORE UPDATE ON users FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER trg_user_profiles_updated_at BEFORE UPDATE ON user_profiles FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER trg_trips_updated_at BEFORE UPDATE ON trips FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER trg_travel_posts_updated_at BEFORE UPDATE ON travel_posts FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
CREATE TRIGGER trg_post_comments_updated_at BEFORE UPDATE ON post_comments FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
